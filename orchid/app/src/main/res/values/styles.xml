<resources>
 <style name="OrchiDWindowAnimations">
  <item name="android:windowEnterAnimation">@anim/fade_in</item><item name="android:windowExitAnimation">@anim/fade_out</item>
  <item name="android:activityOpenEnterAnimation">@anim/fade_in</item><item name="android:activityOpenExitAnimation">@anim/fade_out</item>
  <item name="android:activityCloseEnterAnimation">@anim/fade_in</item><item name="android:activityCloseExitAnimation">@anim/fade_out</item>
 </style>
 <style name="OrchiDDialogDark" parent="android:style/Theme.Material.Dialog.Alert"><item name="android:windowAnimationStyle">@style/OrchiDWindowAnimations</item><item name="android:colorAccent">#CF8BFA</item></style>
 <style name="OrchiDDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert"><item name="android:windowAnimationStyle">@style/OrchiDWindowAnimations</item><item name="android:colorAccent">#9A238F</item></style>
 <style name="Theme.OrChiD" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#CF8BFA</item><item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#19131F</item><item name="android:navigationBarColor">#19131F</item><item name="android:windowBackground">#19131F</item><item name="android:windowActionModeOverlay">true</item><item name="android:windowAnimationStyle">@style/OrchiDWindowAnimations</item><item name="android:alertDialogTheme">@style/OrchiDDialogDark</item>
 </style>
 <style name="Theme.OrchiD.Light" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#9A238F</item><item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item><item name="android:statusBarColor">#FFF9FF</item><item name="android:navigationBarColor">#FFF9FF</item><item name="android:windowBackground">#FFF9FF</item><item name="android:windowActionModeOverlay">true</item><item name="android:windowAnimationStyle">@style/OrchiDWindowAnimations</item><item name="android:alertDialogTheme">@style/OrchiDDialogLight</item>
 </style>
</resources>
